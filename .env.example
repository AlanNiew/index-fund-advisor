OPENAI_API_KEY=your-openai-api-key-here
AZURE_OPENAI_API_KEY=your-azure-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here
GOOGLE_API_KEY=your-google-api-key-here
ZHIPUAI_API_KEY=your-zhipuai-api-key-here
DEEPSEEK_API_KEY=your-deepseek-api-key-here
OPENCODE_API_KEY=your-opencode-api-key-here

# —— 可选：不改配置文件就能换模型/端点（环境变量优先级最高） ——
# IFA_LLM_PROVIDER=deepseek
# IFA_DEEP_LLM=deepseek-reasoner
# IFA_QUICK_LLM=deepseek-chat
# IFA_BACKEND_URL=https://api.deepseek.com/v1
# IFA_CUSTOM_API_KEY=your-key-for-custom-endpoint

# —— 每日邮件报告（scripts/daily_analysis.py --email；QQ / 163 用授权码而非登录密码） ——
# IFA_SMTP_HOST=smtp.qq.com
# IFA_SMTP_PORT=465
# IFA_SMTP_USER=you@qq.com
# IFA_SMTP_PASSWORD=your-smtp-auth-code
# IFA_SMTP_SENDER=you@qq.com
# IFA_EMAIL_TO=you@qq.com
# IFA_SMTP_USE_SSL=true
# IFA_SMTP_TIMEOUT=30
